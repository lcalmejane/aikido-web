      "note": {
        "en": "never inside the workspace",
        "fr": "jamais dans l’espace de travail"
      }
    },
    {
      "depth": 1,
      "label": {
        "en": "aikido/tasks/",
        "fr": "aikido/tasks/"
      }
    },
    {
      "depth": 2,
      "label": {
        "en": "<workspace-id>/",
