        "fr": "les événements, qui font foi"
      },
      "accent": true
    },
    {
      "depth": 3,
      "label": {
        "en": "projections",
        "fr": "projections"
      },
      "note": {
        "en": "cards and plans, rebuildable",
        "fr": "cartes et plans, reconstructibles"
      }
    },
    {
      "depth": 3,
      "label": {
        "en": "exclusive lock",
        "fr": "verrou exclusif"
      },
      "note": {
        "en": "no write without it",
        "fr": "aucune écriture sans lui"
