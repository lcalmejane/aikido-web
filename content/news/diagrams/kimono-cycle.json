        "fr": "Figer un snapshot"
      }
    },
    {
      "label": {
        "en": "Search",
        "fr": "Chercher"
      }
    },
    {
      "label": {
        "en": "Read the chosen lines",
        "fr": "Lire les lignes choisies"
      }
    },
    {
      "label": {
        "en": "Release the snapshot",
        "fr": "Libérer le snapshot"
      }
    }
  ]
