        "fr": "la carte entre dans le workflow"
      }
    },
    {
      "label": {
        "en": "Run (host)",
        "fr": "Exécution (hôte)"
      },
      "note": {
        "en": "only the host executes",
        "fr": "seul l’hôte exécute"
      }
    },
    {
      "label": {
        "en": "Review",
        "fr": "Revue"
      },
      "note": {
        "en": "a result never accepts itself",
        "fr": "un résultat ne s’accepte jamais seul"
      }
    },
    {
      "label": {
        "en": "Accepted",
        "fr": "Acceptée"
      },
      "note": {
        "en": "explicit, authorized decision",
        "fr": "décision explicite et autorisée"
      },
      "accent": true
    },
    {
      "label": {
        "en": "Done",
        "fr": "Terminée"
      },
      "note": {
        "en": "a further explicit transition",
        "fr": "une transition explicite de plus"
      }
    }
  ]
